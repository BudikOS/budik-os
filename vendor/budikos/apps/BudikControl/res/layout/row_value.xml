<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/budik_row_min_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/budik_card_inner"
    android:paddingEnd="@dimen/budik_card_inner">
    <TextView android:id="@+id/title" style="@style/Budik.RowTitle"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    <TextView android:id="@+id/value" style="@style/Budik.Value"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" />
</LinearLayout>
