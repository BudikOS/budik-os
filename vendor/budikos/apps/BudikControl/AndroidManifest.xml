<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.budikos.control"
    android:sharedUserId="android.uid.system">

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_perf"
        android:theme="@style/Theme.BudikControl"
        android:supportsRtl="true"
        android:allowBackup="false">

        <!-- Performance page, injected into the Settings homepage (system apps only) -->
        <activity android:name=".PerfActivity"
            android:exported="true"
            android:label="@string/perf_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data android:name="com.android.settings.title"
                android:resource="@string/perf_title" />
            <meta-data android:name="com.android.settings.summary"
                android:resource="@string/perf_summary" />
            <meta-data android:name="com.android.settings.icon"
                android:resource="@drawable/ic_perf" />
            <meta-data android:name="com.android.settings.order" android:value="-55" />
            <!-- grouped in the card with Storage / Battery / System (top_level_settings_expressive) -->
            <meta-data android:name="com.android.settings.group_key"
                android:value="top_level_system_info_category" />
        </activity>

        <!-- Quick Settings tile: a tap cycles battery, balanced, performance -->
        <service android:name=".PerfTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_perf"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
