<?xml version="1.0" encoding="utf-8"?>
<!-- Light / dark / automatic. Picking light or dark repaints the wizard right
     away, which is the preview. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/theme_light"
                style="@style/BudikSetup.Option"
                android:layout_marginEnd="10dp"
                android:drawableTop="@drawable/swatch_light"
                android:text="@string/theme_light" />

            <TextView
                android:id="@+id/theme_dark"
                style="@style/BudikSetup.Option"
                android:layout_marginEnd="10dp"
                android:drawableTop="@drawable/swatch_dark"
                android:text="@string/theme_dark" />

            <TextView
                android:id="@+id/theme_auto"
                style="@style/BudikSetup.Option"
                android:drawableTop="@drawable/swatch_auto"
                android:text="@string/theme_auto" />
        </LinearLayout>

        <TextView
            android:id="@+id/theme_note"
            style="@style/BudikSetup.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
