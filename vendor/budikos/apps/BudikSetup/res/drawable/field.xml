<?xml version="1.0" encoding="utf-8"?>
<!-- Text field (mockup search box): 12 dp, hairline; focused = 2 dp mint frame. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/budik_surface" />
            <stroke android:width="2dp" android:color="@color/budik_accent" />
            <corners android:radius="@dimen/budik_radius_m" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/budik_surface" />
            <stroke android:width="1dp" android:color="@color/budik_border" />
            <corners android:radius="@dimen/budik_radius_m" />
        </shape>
    </item>
</selector>
