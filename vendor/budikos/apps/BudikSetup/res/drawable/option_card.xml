<?xml version="1.0" encoding="utf-8"?>
<!-- Choice card: selected = 2 dp mint frame, otherwise a hairline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/budik_surface" />
            <stroke android:width="2dp" android:color="@color/budik_accent" />
            <corners android:radius="@dimen/budik_radius_l" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/budik_surface" />
            <stroke android:width="1dp" android:color="@color/budik_line" />
            <corners android:radius="@dimen/budik_radius_l" />
        </shape>
    </item>
</selector>
