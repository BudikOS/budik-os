<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog (mockup 11): 20 dp card on a hard 3 dp shadow, no blur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="@dimen/budik_shadow_offset">
        <shape><solid android:color="@color/budik_border" /><corners android:radius="@dimen/budik_radius_l" /></shape>
    </item>
    <item android:bottom="@dimen/budik_shadow_offset">
        <shape>
            <solid android:color="@color/budik_surface" />
            <stroke android:width="1dp" android:color="@color/budik_line" />
            <corners android:radius="@dimen/budik_radius_l" />
        </shape>
    </item>
</layer-list>
