# Budik OS product layer, inherited from device/phh/treble/rom.mk (see build.sh).
# Copied to /src/vendor/budikos by apply.sh. Keep it generic (GSI): device fixes
# that help old vendors (ocean, later Exynos 850 Samsungs) belong here too.

# --- debloat (overrides = module is built but not installed) ---
PRODUCT_PACKAGES += BudikRemovePackages

# --- SELinux: A17 dropped `allow domain ion_device` from domain.te; old QTI
# vendors (QSEECom gatekeeper) need it, otherwise system_server crashes (zycold-fatal)
SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += vendor/budikos/sepolicy/private

# --- boot animation: ours (export/bootanimation, zip -0). The strobing seen on ocean
# came from the RestlessOS zip (removed by apply.sh); ours tested calm at runtime.
# If it ever strobes again: debug.sf.nobootanimation=1
PRODUCT_COPY_FILES += \
    vendor/budikos/bootanimation.zip:system/media/bootanimation.zip

# --- dev: adb enabled from the start on debuggable builds; put your adbkey.pub
# into dev/adb_keys (not tracked) to skip the authorisation prompt
ifneq ($(TARGET_BUILD_VARIANT),user)
ifneq ($(wildcard vendor/budikos/dev/adb_keys),)
PRODUCT_ADB_KEYS := vendor/budikos/dev/adb_keys
endif
PRODUCT_SYSTEM_PROPERTIES += \
    persist.sys.usb.config=adb
endif

# --- look: wallpaper + fonts in system UI (framework overlay), 0.5x animations
PRODUCT_PACKAGES += \
    BudikFrameworkOverlay \
    BudikSettingsProviderOverlay

# wallpapers: replace the RestlessOS ones (stripped from device/phh/treble/base.mk by apply.sh)
PRODUCT_COPY_FILES += \
    vendor/budikos/wallpapers/budik_light.png:system/etc/wallpaper/budik_light.png \
    vendor/budikos/wallpapers/budik_dark.png:system/etc/wallpaper/budik_dark.png
PRODUCT_SYSTEM_PROPERTIES += \
    ro.config.wallpaper=/system/etc/wallpaper/budik_light.png \
    ro.config.lock_wallpaper=/system/etc/wallpaper/budik_dark.png

# --- apps missing in the treble GSI (all from the GrapheneOS tree)
PRODUCT_PACKAGES += \
    Camera \
    DeskClock \
    ExactCalculator \
    Calendar \
    Gallery2

# --- Budik app icons (RRO per app, generated by tools/gen-icon-overlays.sh)
include vendor/budikos/icons.mk

# fonts: replaces vendor/pixel/gsans (dropped from rom.mk by build.sh), same mechanism
PRODUCT_COPY_FILES += \
    vendor/budikos/fonts_customization.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/fonts_customization.xml \
    vendor/budikos/fonts/InstrumentSans.ttf:$(TARGET_COPY_OUT_PRODUCT)/fonts/InstrumentSans.ttf \
    vendor/budikos/fonts/SchibstedGrotesk.ttf:$(TARGET_COPY_OUT_PRODUCT)/fonts/SchibstedGrotesk.ttf
include vendor/budikos/sysui.mk

# --- GPU/battery: ocean's vendor sets persist.sys.sf.color_saturation=1.1; HWC 2.1 can't
# apply a color matrix, so SurfaceFlinger composes EVERY layer on the GPU (CLIENT).
# 1.0 = neutral, layers go back to HWC overlays. Product props load last, so this wins.
PRODUCT_PRODUCT_PROPERTIES += \
    persist.sys.sf.color_saturation=1.0

# --- system icons (status bar, QS, nav) from export/icons, tools/gen-system-icons.sh
PRODUCT_PACKAGES += BudikSystemIconsOverlay

# --- performance profiles and RAM Plus (persist.sys.budik.*), see perf/budik_perf.rc
include vendor/budikos/perf/perf.mk
