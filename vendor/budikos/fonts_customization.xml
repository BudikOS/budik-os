<?xml version="1.0" encoding="utf-8"?>
<!-- Budik OS fonts (SIL OFL 1.1), downloaded by build/fetch-fonts.sh -->
<fonts-modification version="1">
  <family customizationType="new-named-family" name="instrument-sans">
    <font weight="400" style="normal">InstrumentSans.ttf<axis tag="wdth" stylevalue="100"/><axis tag="wght" stylevalue="400"/></font>
    <font weight="500" style="normal">InstrumentSans.ttf<axis tag="wdth" stylevalue="100"/><axis tag="wght" stylevalue="500"/></font>
    <font weight="600" style="normal">InstrumentSans.ttf<axis tag="wdth" stylevalue="100"/><axis tag="wght" stylevalue="600"/></font>
    <font weight="700" style="normal">InstrumentSans.ttf<axis tag="wdth" stylevalue="100"/><axis tag="wght" stylevalue="700"/></font>
  </family>
  <family customizationType="new-named-family" name="instrument-sans-medium">
    <font weight="400" style="normal">InstrumentSans.ttf<axis tag="wdth" stylevalue="100"/><axis tag="wght" stylevalue="500"/></font>
    <font weight="700" style="normal">InstrumentSans.ttf<axis tag="wdth" stylevalue="100"/><axis tag="wght" stylevalue="700"/></font>
  </family>
  <family customizationType="new-named-family" name="schibsted-grotesk">
    <font weight="400" style="normal">SchibstedGrotesk.ttf<axis tag="wght" stylevalue="400"/></font>
    <font weight="500" style="normal">SchibstedGrotesk.ttf<axis tag="wght" stylevalue="500"/></font>
    <font weight="600" style="normal">SchibstedGrotesk.ttf<axis tag="wght" stylevalue="600"/></font>
    <font weight="700" style="normal">SchibstedGrotesk.ttf<axis tag="wght" stylevalue="700"/></font>
    <font weight="800" style="normal">SchibstedGrotesk.ttf<axis tag="wght" stylevalue="800"/></font>
  </family>
  <family customizationType="new-named-family" name="schibsted-grotesk-medium">
    <font weight="400" style="normal">SchibstedGrotesk.ttf<axis tag="wght" stylevalue="500"/></font>
    <font weight="700" style="normal">SchibstedGrotesk.ttf<axis tag="wght" stylevalue="700"/></font>
  </family>
  <!-- Alias kept for code that still asks for "jetbrains-mono": the system ships no
       monospace font, so it gets Instrument Sans. -->
  <family customizationType="new-named-family" name="jetbrains-mono">
    <font weight="400" style="normal">InstrumentSans.ttf<axis tag="wdth" stylevalue="100"/><axis tag="wght" stylevalue="400"/></font>
    <font weight="700" style="normal">InstrumentSans.ttf<axis tag="wdth" stylevalue="100"/><axis tag="wght" stylevalue="700"/></font>
  </family>
</fonts-modification>
