// Budik OS static overlays (product partition, enabled automatically)
runtime_resource_overlay {
    name: "BudikFrameworkOverlay",
    product_specific: true,
    manifest: "overlay/BudikFrameworkOverlay/AndroidManifest.xml",
    resource_dirs: ["overlay/BudikFrameworkOverlay/res"],
}

