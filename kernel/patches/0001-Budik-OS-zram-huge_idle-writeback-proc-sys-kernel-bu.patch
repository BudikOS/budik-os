From 206f41deb2e3aaf6ae640d4d4638501f2f176467 Mon Sep 17 00:00:00 2001
From: Budik OS <info@budikstore.org>
Date: Tue, 6 Oct 2026 08:16:19 +0200
Subject: [PATCH] Budik OS: zram huge_idle writeback + /proc/sys/kernel/budik
 profile tunables

---
 drivers/block/zram/zram_drv.c    |   8 +-
 drivers/cpufreq/Kconfig          |   7 +
 drivers/cpufreq/Makefile         |   1 +
 drivers/cpufreq/budik_tune.c     | 218 +++++++++++++++++++++++++++++++
 drivers/cpufreq/cpu-boost.c      |   2 +-
 kernel/sched/cpufreq_schedutil.c |  55 ++++++++
 6 files changed, 287 insertions(+), 4 deletions(-)
 create mode 100644 drivers/cpufreq/budik_tune.c

diff --git a/drivers/block/zram/zram_drv.c b/drivers/block/zram/zram_drv.c
index d11775a04..f4f40e15f 100644
--- a/drivers/block/zram/zram_drv.c
+++ b/drivers/block/zram/zram_drv.c
@@ -637,7 +637,7 @@ static ssize_t writeback_store(struct device *dev,
 	struct bio bio;
 	struct page *page;
 	ssize_t ret, sz;
-	char mode_buf[8];
+	char mode_buf[16];
 	int mode = -1;
 	unsigned long blk_idx = 0;
 
@@ -653,6 +653,8 @@ static ssize_t writeback_store(struct device *dev,
 		mode = IDLE_WRITEBACK;
 	else if (!strcmp(mode_buf, "huge"))
 		mode = HUGE_WRITEBACK;
+	else if (!strcmp(mode_buf, "huge_idle"))
+		mode = IDLE_WRITEBACK | HUGE_WRITEBACK;
 
 	if (mode == -1)
 		return -EINVAL;
@@ -706,10 +708,10 @@ static ssize_t writeback_store(struct device *dev,
 				zram_test_flag(zram, index, ZRAM_UNDER_WB))
 			goto next;
 
-		if (mode == IDLE_WRITEBACK &&
+		if ((mode & IDLE_WRITEBACK) &&
 			  !zram_test_flag(zram, index, ZRAM_IDLE))
 			goto next;
-		if (mode == HUGE_WRITEBACK &&
+		if ((mode & HUGE_WRITEBACK) &&
 			  !zram_test_flag(zram, index, ZRAM_HUGE))
 			goto next;
 		/*
diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
index 379080c63..759f798d4 100644
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -228,6 +228,13 @@ config CPU_FREQ_GOV_CONSERVATIVE
 
 	  If in doubt, say N.
 
+config BUDIK_TUNE
+	bool "Budik OS performance profile tunables (/proc/sys/kernel/budik)"
+	depends on CPU_FREQ
