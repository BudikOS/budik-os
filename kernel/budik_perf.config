# SPDX-License-Identifier: GPL-2.0
# Budik OS config fragment on top of ocean_defconfig (kernel/build.sh budik_perf.config)
CONFIG_LOCALVERSION="-BudikOS"
# less scheduler and debug overhead
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_DEBUG_INFO is not set
# deadline instead of CFQ on eMMC
CONFIG_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_DEADLINE=y
# CONFIG_DEFAULT_CFQ is not set
CONFIG_DEFAULT_IOSCHED="deadline"
# BPF JIT for netd on Android 16+.
# Not JIT_ALWAYS_ON: on 4.9 programs the JIT cannot handle then fail with ENOTSUPP,
# netd1shot fails and the phone boot loops.
CONFIG_BPF_JIT=y
# CONFIG_BPF_JIT_ALWAYS_ON is not set
# zram with LZ4 (4.9 selects the algorithm at runtime: comp_algorithm=lz4)
CONFIG_CRYPTO_LZ4=y
# performance profiles in /proc/sys/kernel/budik/* (patches/0001), writable by init
CONFIG_BUDIK_TUNE=y
# No LTO: LTO_CLANG on 4.9 needs ld.gold with LLVMgold, the gain is 1-3 %.
# less memory and CPU spent on debugging: msm IPC log buffers, full symbol table
# CONFIG_IPC_LOGGING is not set
# CONFIG_KALLSYMS_ALL is not set
# do not wake idle cores for unbound work
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
