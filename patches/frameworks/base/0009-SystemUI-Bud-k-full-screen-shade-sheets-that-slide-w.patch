diff --git a/packages/SystemUI/compose/features/src/com/android/systemui/scene/ui/composable/transitions/BudikSheetSlide.kt b/packages/SystemUI/compose/features/src/com/android/systemui/scene/ui/composable/transitions/BudikSheetSlide.kt
