+/**
+ * Budík OS design tokens for the SystemUI Compose surfaces (export/README.md, tokens.json):
+ * radii 6/12/20 dp, hard 0x3 dp shadow without blur, mint #21D4BE never as text on light
+ * backgrounds, text on mint is always #0E0F11, navy primary buttons, keycap buttons without key
+ * captions, JetBrains Mono for metadata, Schibsted Grotesk headlines, Instrument Sans body text.
+ */
+object Budik {
+    val Ink = Color(0xFF0E0F11)
+    val White = Color(0xFFFFFFFF)
+    val Mint = Color(0xFF21D4BE)
+    val MintInk = Color(0xFF05332E)
+    val Navy = Color(0xFF0B1E52)
+    val NavyInk = Color(0xFF050E29)
+
+    val RadiusS = 6.dp
+    val RadiusM = 12.dp
+    val RadiusL = 20.dp
+
+    /** Depth of the hard keycap shadow (offset 0 x 3 dp, no blur). */
+    val KeyDepth = 3.dp
+
+    @Immutable
+    data class Colors(
+        val isDark: Boolean,
+        val bg: Color,
+        val surface: Color,
+        val line: Color,
+        val border: Color,
+        val fg: Color,
+        val fg2: Color,
+        val fg3: Color,
+        val primary: Color,
+        val primaryShadow: Color,
+        /** Secondary keycap (white key on light, raised grey key on dark). */
+        val key: Color,
+        val keyShadow: Color,
+        val keyBorder: Color,
+        /** Control centre: always a dark sheet. */
+        val ccPanel: Color,
+        val ccBorder: Color,
+        val ccText: Color,
+        val ccHandle: Color,
+        val ccKeyOff: Color,
+        val ccKeyOffShadow: Color,
+        val ccOnKeyOff: Color,
+        val ccUnavailable: Color,
+        val ccOnUnavailable: Color,
+        val ccSegmentOff: Color,
+    )
+
+    private val Light =
+        Colors(
+            isDark = false,
+            bg = Color(0xFFF5F6F7),
+            surface = White,
+            line = Color(0xFFE3E5E8),
+            border = Color(0xFFCFD3D8),
+            fg = Ink,
+            fg2 = Color(0xFF3A3E43),
+            fg3 = Color(0xFF5A6370),
+            primary = Navy,
+            primaryShadow = NavyInk,
+            key = White,
+            keyShadow = Color(0xFFE3E5E8),
+            keyBorder = Color(0xFFE3E5E8),
+            ccPanel = Ink,
+            ccBorder = Ink,
+            ccText = Color(0xFFC4C8CE),
+            ccHandle = Color(0xFF3A3F46),
+            ccKeyOff = White,
+            ccKeyOffShadow = Color(0xFFA9AFB7),
+            ccOnKeyOff = Ink,
+            ccUnavailable = Color(0xFF3A3F46),
+            ccOnUnavailable = Color(0xFF8D949E),
+            ccSegmentOff = Color(0xFFE3E5E8),
+        )
+
+    private val Dark =
+        Colors(
+            isDark = true,
+            bg = Ink,
+            surface = Color(0xFF17191C),
+            line = Color(0xFF262A2F),
+            border = Color(0xFF3A3F46),
+            fg = Color(0xFFF5F6F7),
+            fg2 = Color(0xFFC4C8CE),
+            fg3 = Color(0xFF8D949E),
+            primary = Color(0xFF2A4291),
+            primaryShadow = Navy,
+            key = Color(0xFF1E2024),
+            keyShadow = Color(0xFF08090A),
+            keyBorder = Color(0xFF3A3F46),
+            ccPanel = Color(0xFF17191C),
+            ccBorder = Color(0xFF262A2F),
+            ccText = Color(0xFFC4C8CE),
+            ccHandle = Color(0xFF3A3F46),
+            ccKeyOff = Color(0xFF2A2D32),
+            ccKeyOffShadow = Color(0xFF08090A),
+            ccOnKeyOff = Color(0xFFF5F6F7),
+            ccUnavailable = Color(0xFF1E2024),
+            ccOnUnavailable = Color(0xFF5A6370),
+            ccSegmentOff = Color(0xFF33373D),
+        )
+
+    val colors: Colors
+        @Composable @ReadOnlyComposable get() = if (isSystemInDarkTheme()) Dark else Light
+
+    // Families come from vendor/budikos fonts_customization.xml. Device fonts are optional: if a
+    // family is missing (e.g. a GSI without our fonts) Compose falls back to the platform default.
+    val Mono =
+        FontFamily(
+            Font(DeviceFontFamilyName("jetbrains-mono"), FontWeight.Normal),
+            Font(DeviceFontFamilyName("jetbrains-mono"), FontWeight.Bold),
+        )
+    val Headline =
+        FontFamily(
+            Font(DeviceFontFamilyName("schibsted-grotesk"), FontWeight.Normal),
+            Font(DeviceFontFamilyName("schibsted-grotesk"), FontWeight.SemiBold),
+            Font(DeviceFontFamilyName("schibsted-grotesk"), FontWeight.Bold),
+            Font(DeviceFontFamilyName("schibsted-grotesk"), FontWeight.ExtraBold),
+        )
+    val Body =
+        FontFamily(
+            Font(DeviceFontFamilyName("instrument-sans"), FontWeight.Normal),
+            Font(DeviceFontFamilyName("instrument-sans"), FontWeight.Medium),
+            Font(DeviceFontFamilyName("instrument-sans"), FontWeight.SemiBold),
+            Font(DeviceFontFamilyName("instrument-sans"), FontWeight.Bold),
+        )
+
+    fun mono(size: TextUnit, color: Color, weight: FontWeight = FontWeight.Normal) =
+        TextStyle(
+            fontFamily = Mono,
+            fontSize = size,
+            fontWeight = weight,
+            color = color,
+            letterSpacing = 0.04.em(size),
+        )
+
+    fun headline(size: TextUnit, color: Color, weight: FontWeight = FontWeight.Bold) =
+        TextStyle(
+            fontFamily = Headline,
+            fontSize = size,
+            fontWeight = weight,
+            color = color,
+            letterSpacing = (-0.02).em(size),
+        )
+
+    fun body(size: TextUnit, color: Color, weight: FontWeight = FontWeight.Normal) =
+        TextStyle(fontFamily = Body, fontSize = size, fontWeight = weight, color = color)
+
+    private fun Double.em(size: TextUnit): TextUnit = (size.value * this).sp
+}
+
+/**
+ * Draws a keycap: [face] with a hard [shadow] offset [Budik.KeyDepth] below it. The modifier
+ * reserves the shadow depth at the bottom of the element; [pressed] sinks the face into the
+ * shadow.
+ */
+fun Modifier.budikKeycap(
+    face: Color,
+    shadow: Color,
+    radius: Dp = Budik.RadiusS,
+    border: Color = Color.Unspecified,
+    pressed: Boolean = false,
+): Modifier =
+    drawBehind {
+            val depth = Budik.KeyDepth.toPx()
+            val corner = CornerRadius(radius.toPx())
+            val faceSize = Size(size.width, size.height - depth)
+            val sink = if (pressed) depth * 2f / 3f else 0f
+            drawRoundRect(shadow, Offset(0f, depth), faceSize, corner)
+            drawRoundRect(face, Offset(0f, sink), faceSize, corner)
+            if (border != Color.Unspecified) {
+                val w = 1.dp.toPx()
+                drawRoundRect(
+                    border,
+                    Offset(w / 2f, sink + w / 2f),
+                    Size(faceSize.width - w, faceSize.height - w),
+                    CornerRadius(corner.x - w / 2f),
+                    style = Stroke(w),
+                )
+            }
+        }
+        .padding(bottom = Budik.KeyDepth)
+        .offset { IntOffset(0, if (pressed) (Budik.KeyDepth * 2f / 3f).roundToPx() else 0) }
+
+/** A pressable keycap without ripple; the press sinks the key instead. */
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+fun BudikKey(
+    face: Color,
+    shadow: Color,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    radius: Dp = Budik.RadiusS,
+    border: Color = Color.Unspecified,
+    onLongClick: (() -> Unit)? = null,
+    enabled: Boolean = true,
+    content: @Composable BoxScope.() -> Unit,
+) {
+    val interactionSource = remember { MutableInteractionSource() }
+    val pressed by interactionSource.collectIsPressedAsState()
+    Box(
+        modifier =
+            modifier
+                .combinedClickable(
+                    interactionSource = interactionSource,
+                    indication = null,
+                    enabled = enabled,
+                    role = Role.Button,
+                    onLongClick = onLongClick,
+                    onClick = onClick,
+                )
+                .budikKeycap(face, shadow, radius, border, pressed),
+        content = content,
+    )
+}
