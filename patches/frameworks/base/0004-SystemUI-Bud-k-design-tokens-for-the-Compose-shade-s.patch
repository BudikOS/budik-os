+/** Budík line icons (export/icons/ui, 24 dp grid, stroke 2, round caps and joins). */
+object BudikIcons {
+    val Edit by lazy { stroke("M5 19l1-4L15.5 5.5a2.1 2.1 0 0 1 3 3L9 18z") }
+    val Power by lazy { stroke("M12 3v8", "M6.6 6.6a7.6 7.6 0 1 0 10.8 0") }
+    val Tune by lazy {
+        stroke(
+            "M4 8h7M15 8h5M4 16h3M11 16h9",
+            "M11 8a2 2 0 1 0 4 0a2 2 0 1 0 -4 0",
+            "M7 16a2 2 0 1 0 4 0a2 2 0 1 0 -4 0",
+        )
+    }
+    val Brightness by lazy {
+        stroke(
+            "M8 12A4 4 0 1 0 16 12A4 4 0 1 0 8 12Z",
+            "M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4" +
+                "M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4",
+        )
+    }
+
+    /** brand/logo with inverted colours, for dark surfaces. */
+    val LogoOnDark by lazy { logo(face = Color.White, glyph = Budik.Ink) }
+    /** brand/logo as exported, for light surfaces. */
+    val Logo by lazy { logo(face = Budik.Ink, glyph = Color.White) }
+
+    private fun builder() =
+        ImageVector.Builder(
+            defaultWidth = 24.dp,
+            defaultHeight = 24.dp,
+            viewportWidth = 24f,
+            viewportHeight = 24f,
+        )
+
+    private fun stroke(vararg paths: String): ImageVector =
+        builder()
+            .apply {
+                paths.forEach {
+                    addPath(
+                        pathData = addPathNodes(it),
+                        stroke = SolidColor(Color.White),
+                        strokeLineWidth = 2f,
+                        strokeLineCap = StrokeCap.Round,
+                        strokeLineJoin = StrokeJoin.Round,
+                    )
+                }
+            }
+            .build()
+
+    private fun logo(face: Color, glyph: Color): ImageVector =
+        builder()
+            .addPath(
+                pathData =
+                    addPathNodes(
+                        "M5.8 0H18.2A5.8 5.8 0 0 1 24 5.8V18.2A5.8 5.8 0 0 1 18.2 24H5.8" +
+                            "A5.8 5.8 0 0 1 0 18.2V5.8A5.8 5.8 0 0 1 5.8 0Z"
+                    ),
+                fill = SolidColor(face),
+            )
+            .addPath(
+                pathData =
+                    addPathNodes(
+                        "M8.44 4.03H12.35A3.73 3.73 0 0 1 15.25 10.13A3.75 3.75 0 0 1 12.84 " +
+                            "16.78H8.44V15.56H7.22V5.25H8.44ZM9.66 6.42H12.35A1.36 1.36 0 0 1 " +
+                            "12.35 9.14H9.66ZM9.66 11.6H12.84A1.36 1.36 0 0 1 12.84 14.32H9.66Z"
+                    ),
+                fill = SolidColor(glyph),
+                pathFillType = PathFillType.EvenOdd,
+            )
+            .addPath(pathData = addPathNodes("M7.22 17.91H16.59V19.97H7.22Z"), fill = SolidColor(Budik.Mint))
+            .build()
+}
