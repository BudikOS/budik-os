+</ripple>
diff --git a/packages/SettingsLib/SettingsTheme/res/drawable/settingslib_budik_dialog_background.xml b/packages/SettingsLib/SettingsTheme/res/drawable/settingslib_budik_dialog_background.xml
new file mode 100644
index 000000000000..b30341748f25
--- /dev/null
+++ b/packages/SettingsLib/SettingsTheme/res/drawable/settingslib_budik_dialog_background.xml
@@ -0,0 +1,23 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Budík OS dialog card: surface, radius 20, 1dp line, hard 4dp shadow (no blur, no elevation). -->
+<inset xmlns:android="http://schemas.android.com/apk/res/android"
+    android:insetLeft="24dp"
+    android:insetRight="24dp"
+    android:insetTop="16dp"
+    android:insetBottom="16dp">
+    <layer-list>
+        <item android:top="4dp">
+            <shape android:shape="rectangle">
+                <solid android:color="@color/settingslib_budik_dialog_shadow" />
+                <corners android:radius="@dimen/settingslib_budik_radius_l" />
+            </shape>
+        </item>
+        <item android:bottom="4dp">
+            <shape android:shape="rectangle">
+                <solid android:color="@color/settingslib_budik_surface" />
+                <stroke android:width="1dp" android:color="@color/settingslib_budik_line" />
+                <corners android:radius="@dimen/settingslib_budik_radius_l" />
+            </shape>
+        </item>
+    </layer-list>
+</inset>
diff --git a/packages/SettingsLib/SettingsTheme/res/drawable/settingslib_budik_switch_thumb.xml b/packages/SettingsLib/SettingsTheme/res/drawable/settingslib_budik_switch_thumb.xml
new file mode 100644
index 000000000000..bc62bffe1dee
--- /dev/null
+++ b/packages/SettingsLib/SettingsTheme/res/drawable/settingslib_budik_switch_thumb.xml
@@ -0,0 +1,44 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Budík OS keycap switch thumb: 18dp square, concentric with the track (radius 3). -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_enabled="false">
+        <layer-list>
+            <item android:width="18dp" android:height="26dp">
+                <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
+            </item>
+            <item android:width="18dp" android:height="18dp" android:gravity="center">
+                <shape android:shape="rectangle">
+                    <solid android:color="@color/settingslib_budik_switch_thumb_disabled" />
+                    <corners android:radius="3dp" />
+                </shape>
+            </item>
+        </layer-list>
+    </item>
+    <item android:state_checked="true">
+        <layer-list>
+            <item android:width="18dp" android:height="26dp">
+                <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
+            </item>
+            <item android:width="18dp" android:height="18dp" android:gravity="center">
+                <shape android:shape="rectangle">
+                    <solid android:color="@color/settingslib_budik_switch_thumb_on" />
+                    <corners android:radius="3dp" />
+                </shape>
+            </item>
+        </layer-list>
+    </item>
+    <item>
+        <layer-list>
+            <item android:width="18dp" android:height="26dp">
+                <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
+            </item>
+            <item android:width="18dp" android:height="18dp" android:gravity="center">
+                <shape android:shape="rectangle">
+                    <solid android:color="@color/settingslib_budik_switch_thumb_off" />
+                    <stroke android:width="2dp" android:color="@color/settingslib_budik_switch_stroke_off" />
+                    <corners android:radius="3dp" />
+                </shape>
+            </item>
+        </layer-list>
+    </item>
+</selector>
diff --git a/packages/SettingsLib/SettingsTheme/res/drawable/settingslib_budik_switch_track.xml b/packages/SettingsLib/SettingsTheme/res/drawable/settingslib_budik_switch_track.xml
new file mode 100644
index 000000000000..b0330b444707
--- /dev/null
+++ b/packages/SettingsLib/SettingsTheme/res/drawable/settingslib_budik_switch_track.xml
@@ -0,0 +1,31 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Budík OS keycap switch track, 44 x 26 dp, radius 6. The 4dp side padding keeps the
+     thumb inside the 2dp stroke (SwitchCompat reads the track padding). -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_enabled="false">
+        <shape android:shape="rectangle">
+            <size android:width="44dp" android:height="26dp" />
+            <solid android:color="@color/settingslib_budik_switch_disabled" />
+            <corners android:radius="@dimen/settingslib_budik_radius_s" />
+            <padding android:left="4dp" android:right="4dp" />
+        </shape>
+    </item>
+    <item android:state_checked="true">
+        <shape android:shape="rectangle">
+            <size android:width="44dp" android:height="26dp" />
+            <solid android:color="@color/settingslib_budik_mint" />
+            <stroke android:width="2dp" android:color="@color/settingslib_budik_switch_stroke_on" />
+            <corners android:radius="@dimen/settingslib_budik_radius_s" />
+            <padding android:left="4dp" android:right="4dp" />
+        </shape>
+    </item>
+    <item>
+        <shape android:shape="rectangle">
+            <size android:width="44dp" android:height="26dp" />
+            <solid android:color="@color/settingslib_budik_switch_track_off" />
+            <stroke android:width="2dp" android:color="@color/settingslib_budik_switch_stroke_off" />
+            <corners android:radius="@dimen/settingslib_budik_radius_s" />
+            <padding android:left="4dp" android:right="4dp" />
+        </shape>
+    </item>
+</selector>
