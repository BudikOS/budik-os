+<?xml version="1.0" encoding="utf-8"?>
+<!-- Budík OS design tokens (export/res/values/colors.xml), light. -->
+<resources>
+    <color name="settingslib_budik_bg">#F5F6F7</color>
+    <color name="settingslib_budik_surface">#FFFFFF</color>
+    <color name="settingslib_budik_line">#E3E5E8</color>
+    <color name="settingslib_budik_border">#CFD3D8</color>
+    <color name="settingslib_budik_fg">#0E0F11</color>
+    <color name="settingslib_budik_fg2">#3A3E43</color>
+    <color name="settingslib_budik_fg3">#5A6370</color>
+    <color name="settingslib_budik_pixel">#EEF0F2</color>
+    <!-- primary (navy) buttons -->
+    <color name="settingslib_budik_primary">#0B1E52</color>
+    <color name="settingslib_budik_primary_ink">#050E29</color>
+    <color name="settingslib_budik_on_primary">#FFFFFF</color>
+    <!-- accent: never as text on light, text on mint is always ink -->
+    <color name="settingslib_budik_mint">#21D4BE</color>
+    <color name="settingslib_budik_mint_ink">#05332E</color>
+    <color name="settingslib_budik_ink">#0E0F11</color>
+    <color name="settingslib_budik_inverse">#0E0F11</color>
+    <color name="settingslib_budik_on_inverse">#FFFFFF</color>
+    <!-- keycap -->
+    <color name="settingslib_budik_key_face">#F5F6F7</color>
+    <color name="settingslib_budik_key_shadow">#E3E5E8</color>
+    <color name="settingslib_budik_dialog_shadow">#CFD3D8</color>
+    <!-- switch -->
+    <color name="settingslib_budik_switch_track_off">#E3E5E8</color>
+    <color name="settingslib_budik_switch_stroke_off">#CFD3D8</color>
+    <color name="settingslib_budik_switch_stroke_on">#0E0F11</color>
+    <color name="settingslib_budik_switch_thumb_off">#FFFFFF</color>
+    <color name="settingslib_budik_switch_thumb_on">#0E0F11</color>
+    <color name="settingslib_budik_switch_disabled">#EEF0F2</color>
+    <color name="settingslib_budik_switch_thumb_disabled">#E3E5E8</color>
+</resources>
