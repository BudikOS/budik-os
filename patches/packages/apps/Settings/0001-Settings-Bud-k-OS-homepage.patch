+    /**
+     * Budík OS: injected glyphs get the same keycap frame as the built-in homepage icons
+     * (ic_homepage_*: 36dp face, 3dp hard shadow, 20dp glyph in the text colour).
+     */
+    private Drawable getBudikKeycapIcon(Drawable glyph) {
+        glyph.setTint(mContext.getColor(R.color.settingslib_budik_fg));
+        final LayerDrawable icon = new LayerDrawable(new Drawable[] {
+                mContext.getDrawable(R.drawable.budik_keycap_shadow),
+                mContext.getDrawable(R.drawable.budik_keycap_face),
+                glyph});
+        final float density = mContext.getResources().getDisplayMetrics().density;
+        icon.setLayerInsetRelative(0, dp(2, density), dp(3, density), dp(2, density), dp(1, density));
+        icon.setLayerInsetRelative(1, dp(2, density), 0, dp(2, density), dp(4, density));
+        icon.setLayerSize(2, dp(20, density), dp(20, density));
+        icon.setLayerInsetRelative(2, dp(10, density), dp(8, density), 0, 0);
+        return icon;
+    }
+
+    private static int dp(int value, float density) {
+        return Math.round(value * density);
     }
 
