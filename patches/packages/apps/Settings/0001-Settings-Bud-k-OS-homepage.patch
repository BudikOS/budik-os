diff --git a/res/drawable/budik_search_bar_background.xml b/res/drawable/budik_search_bar_background.xml
new file mode 100644
index 0000000..1604c03
--- /dev/null
+++ b/res/drawable/budik_search_bar_background.xml
@@ -0,0 +1,30 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Budík OS keycap search field (export/mockups/*/06_settings): surface face, 1dp border,
+     radius 12, hard 3dp shadow in the line colour; mint 2dp frame when focused. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="?android:attr/colorControlHighlight">
+    <item android:top="3dp">
+        <shape android:shape="rectangle">
+            <solid android:color="@color/settingslib_budik_line" />
+            <corners android:radius="@dimen/settingslib_budik_radius_m" />
+        </shape>
+    </item>
+    <item android:bottom="3dp">
+        <selector>
+            <item android:state_focused="true">
+                <shape android:shape="rectangle">
+                    <solid android:color="@color/settingslib_budik_surface" />
+                    <stroke android:width="2dp" android:color="@color/settingslib_budik_mint" />
+                    <corners android:radius="@dimen/settingslib_budik_radius_m" />
+                </shape>
+            </item>
+            <item>
+                <shape android:shape="rectangle">
+                    <solid android:color="@color/settingslib_budik_surface" />
+                    <stroke android:width="1dp" android:color="@color/settingslib_budik_border" />
+                    <corners android:radius="@dimen/settingslib_budik_radius_m" />
+                </shape>
+            </item>
+        </selector>
+    </item>
+</ripple>
