@@ -0,0 +1,17 @@
+﻿<?xml version="1.0" encoding="utf-8"?>
+<!-- BudĂ­k OS homepage geometry (export/mockups/*/06_settings, 360 x 785 dp). -->
+<resources>
+    <dimen name="budik_homepage_title_padding_top">10dp</dimen>
+    <dimen name="budik_homepage_title_padding_bottom">8dp</dimen>
+    <dimen name="budik_homepage_title_padding_start">14dp</dimen>
+    <!-- 44dp face + 3dp hard shadow -->
+    <dimen name="budik_search_bar_height">47dp</dimen>
+    <!-- compact iOS-like rows, title only: 48dp touch height (iOS 44pt, Pixel 72dp) -->
+    <dimen name="budik_homepage_row_min_height">48dp</dimen>
+    <dimen name="budik_homepage_row_padding">6dp</dimen>
+    <!-- 40dp keycap icon drawable scaled to 28dp (iOS 29pt): 25dp face, 14dp glyph -->
+    <dimen name="budik_homepage_icon_size">28dp</dimen>
+    <!-- rows get the adapter normal padding (16dp); +6dp puts icon and chevron at
+         card margin + card inner padding (8 + 14dp) from the screen edge -->
+    <dimen name="budik_homepage_icon_padding_start">6dp</dimen>
+</resources>
