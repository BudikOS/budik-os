diff --git a/res/drawable/budik_result_row.xml b/res/drawable/budik_result_row.xml
new file mode 100644
index 0000000..125cfbc
--- /dev/null
+++ b/res/drawable/budik_result_row.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Budík OS result row: press ripple and a 1dp divider line at the bottom. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="?android:attr/colorControlHighlight">
+    <item android:gravity="bottom" android:height="1dp" android:drawable="@color/budik_line" />
+    <item android:id="@android:id/mask" android:drawable="@android:color/white" />
+</ripple>
diff --git a/res/drawable/budik_results_card.xml b/res/drawable/budik_results_card.xml
new file mode 100644
index 0000000..acb50ad
--- /dev/null
+++ b/res/drawable/budik_results_card.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Budík OS: results grouped in one card (surface, 1dp line, radius 20). -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
+    <solid android:color="@color/budik_surface" />
+    <stroke android:width="1dp" android:color="@color/budik_line" />
+    <corners android:radius="20dp" />
+</shape>
diff --git a/res/drawable/budik_search_field.xml b/res/drawable/budik_search_field.xml
new file mode 100644
index 0000000..cb7e35f
--- /dev/null
+++ b/res/drawable/budik_search_field.xml
@@ -0,0 +1,19 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Budík OS search field, same as the Settings homepage: surface, 1dp border, radius 12,
+     hard 3dp shadow in the line colour. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="?android:attr/colorControlHighlight">
+    <item android:top="3dp">
+        <shape android:shape="rectangle">
+            <solid android:color="@color/budik_line" />
+            <corners android:radius="12dp" />
+        </shape>
+    </item>
+    <item android:bottom="3dp">
+        <shape android:shape="rectangle">
+            <solid android:color="@color/budik_surface" />
+            <stroke android:width="1dp" android:color="@color/budik_border" />
+            <corners android:radius="12dp" />
+        </shape>
+    </item>
+</ripple>
